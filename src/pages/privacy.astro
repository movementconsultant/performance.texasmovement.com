---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description = "Privacy policy for Texas Movement Performance. Full policy text is pending.";
---

<BaseLayout title={title} description={description} path="/privacy">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <div class="notice">
        <p>
          <strong>Policy content pending.</strong> Texas Movement Performance
          has not yet published a finalized privacy policy for this
          property. This page is a placeholder so the route exists — it does
          not represent real policy text. See
          <code>docs/LAUNCH_BLOCKERS.md</code> for status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
