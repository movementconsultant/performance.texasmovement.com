---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Terms of Service";
const description = "Terms of service for Texas Movement Performance. Full terms text is pending.";
---

<BaseLayout title={title} description={description} path="/terms">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Legal</span>
      <h1>Terms of Service</h1>
      <div class="notice">
        <p>
          <strong>Policy content pending.</strong> Texas Movement Performance
          has not yet published finalized terms of service for this
          property. This page is a placeholder so the route exists — it does
          not represent real legal text. See
          <code>docs/LAUNCH_BLOCKERS.md</code> for status.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
